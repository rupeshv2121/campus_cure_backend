# CampusCure backend configuration.
# Copy to .env and fill in. NEVER commit .env or put real values in this file.

# --- Required. The server refuses to start without these (src/config/env.ts) ---

# Supabase Postgres connection string (pooled).
DATABASE_URL=

# CC-01b: access token lifetime. Accepts "15m", "2h" or a plain number of
# seconds. Short by design — an access token cannot be revoked, so its blast
# radius is bounded only by how long it lives. The refresh token behind it
# carries the session and IS revocable.
# Raise this without a deploy if 15 minutes proves too aggressive.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing this invalidates every issued token and logs all users out.
JWT_SECRET=

# --- Optional ---

# Extra origin allowed by CORS, e.g. http://localhost:5173
# localhost:5173/5174 and the deployed frontend are always allowed.
FRONTEND_URL=

# "production" enables production behaviour. Defaults to "development".
NODE_ENV=

# --- AI / embeddings (CC-10). All optional: the app runs fully without them. ---

# HuggingFace token. MUST have the global "Make calls to Inference Providers"
# permission — a plain Read token returns 403. Get one at:
#   https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Canonical embedding model. Changing it invalidates every stored vector and
# requires a full backfill — vectors from different models are not comparable.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Measured ~7ms/item at 50, vs ~572ms for a single item. Batch generously.
EMBEDDING_BATCH_SIZE=50

# Master switch. Defaults on when HF_API_TOKEN is set; "false" always wins.
AI_ENABLED=true

# Shared secret for /api/internal/* (the embedding drain). Machine-to-machine
# only. Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# Set this in Vercel to let Cron call the drain (sent as Authorization: Bearer).
CRON_SECRET=

# CC-13 duplicate complaint detection. Cosine-similarity floor for calling two
# complaints duplicates. Calibrated on 16 labelled pairs: lowest true duplicate
# 0.538, highest distinct pair 0.499. Narrow margin - re-run
#   npx tsx src/scripts/calibrateDuplicateThreshold.ts
# before changing it.
DUPLICATE_SIMILARITY_THRESHOLD=0.52

# --- Generation providers (CC-12, CC-15). Optional; features degrade without them. ---

# Groq. Model IDs discovered live 2026-09-20 from /openai/v1/models - the
# catalogue had changed completely from what documentation suggested, so list it
# rather than trusting any written-down id:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#
# NOTE: gpt-oss is a REASONING model. It emits reasoning tokens before content,
# so a small max_tokens returns content:"" with finish_reason:"stop" - no error,
# just silence. Budget generously and treat empty content as a failure.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mistral, used as the generation fallback and for vision (CC-50).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-medium-latest

# CC-12: hours a doubt must go unanswered before an AI draft is generated.
# Humans get first refusal - without this the AI would always answer first and
# undercut the student community CC-25 exists to build.
DRAFT_DELAY_HOURS=24

# CC-12: minimum cosine similarity for a past answer to be usable as grounding
# for an AI draft. Search can rank loosely related results and let the reader
# judge; grounding cannot — irrelevant grounding produces a draft that says
# "the reference material does not cover this", wasting the reviewer's time.
GROUNDING_SIMILARITY_THRESHOLD=0.45

# CC-04: set to a THROWAWAY database to enable Tier 2 integration tests.
# Leave unset for normal runs. The suite aborts if this is unset while
# DATABASE_URL points at Supabase, so a misconfigured run cannot touch
# production.
TEST_DATABASE_URL=

# CC-14: complaint intake strategy.
#   false (default) - rules run first, model only on a miss
#   true            - always consult the model
# Measured on 20 labelled complaints: rules-first 85%, model-always 95%. The
# whole gap is "trap" text where a category keyword is incidental (a wasp nest
# outside a WINDOW), because a rules hit never reaches the model. Rules-first
# still answered 55% of cases at zero cost, which is why it is the default.
# Re-measure before changing: npx tsx src/scripts/evalIntake.ts
INTAKE_PREFER_MODEL=false

# ---------------------------------------------------------------------------
# CC-02: file storage (Supabase Storage)
#
# OPTIONAL, like the AI keys above. Leave SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY blank and file uploads switch off cleanly: the two
# upload endpoints answer 503, attachments never appear, and every other
# feature — doubts, complaints, chat — works exactly as before. The app still
# starts.
#
# Both must be set for uploads to work. One without the other is treated as
# off, because a half-configured upload path accepts a student photo, reports
# success, and loses it.
#
# Setup, once per Supabase project:
#   1. Storage -> New bucket -> name it exactly as SUPABASE_STORAGE_BUCKET
#   2. Leave "Public bucket" OFF. Complaint photos can show identifiable
#      people, and a public URL is permanent and unauthenticated.
#   3. Project Settings -> API -> copy the Project URL and service_role key.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# service_role key — bypasses row level security, so it is a full-access
# credential. Server-side only: it must never be sent to the browser, which is
# the entire reason uploads are signed on the backend. Do not commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the bucket created in step 1.
SUPABASE_STORAGE_BUCKET=campuscure-attachments

# Per-file ceiling in bytes (default 5 MB). Enforced twice: against the size
# the client claims when signing, and against the object's real size at
# confirmation — a client can lie about the first.
ATTACHMENT_MAX_BYTES=5242880

# Files per doubt/answer/complaint.
ATTACHMENT_MAX_PER_ENTITY=5

# Lifetime of signed upload / download URLs, in seconds. Downloads are short
# because these URLs get screenshotted and shared.
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# How long an unconfirmed upload survives before the nightly sweep deletes it.
ATTACHMENT_PENDING_TTL_HOURS=24

# ---------------------------------------------------------------------------
# CC-03: email (Resend)
#
# OPTIONAL. With RESEND_API_KEY unset, EMAIL_ENABLED is false: enqueueing is a
# logged no-op, the drain returns zeroes without querying, and every other
# feature is unaffected. The app still starts.
# ---------------------------------------------------------------------------

# https://resend.com -> API Keys. Server-side only; never returned in a response.
RESEND_API_KEY=

# Resend will not accept any other sender until a domain is verified via DNS.
# Changing this before verifying makes every send FAIL, not fall back.
EMAIL_FROM=CampusCure <onboarding@resend.dev>

# SAFETY CATCH - divert every email to one address.
#
# There are real students in this database with real addresses. While the
# domain is unverified Resend only delivers to the account owner anyway, but
# the moment it IS verified an untested drain would mail all of them. Set this
# to your own address and leave it set until the emails themselves (CC-40)
# have been reviewed.
#
# The outbox row always records the true recipient, so turning this off later
# is a config change, not a re-send.
EMAIL_REDIRECT_TO=

# Attempts before a message is parked as FAILED (default 5). A permanent
# rejection - bad address, unverified domain - is parked on the first attempt
# regardless.
EMAIL_MAX_ATTEMPTS=5

# Messages per drain (default 20). Bounded so one drain cannot exhaust the
# free tier's daily quota.
EMAIL_DRAIN_BATCH_SIZE=20

# CC-40: notification emails.
#
# Master switch, default on. Off means no notification ever emails, whatever
# the per-type policy or the user's own preference says - while leaving the
# CC-03 pipe available for anything else.
NOTIFICATION_EMAILS_ENABLED=true

# Public base URL of THIS backend. The unsubscribe link is clicked from an
# inbox and must reach the API, which is a different origin from the frontend -
# using FRONTEND_URL for it gives every recipient a 404.
PUBLIC_API_URL=https://campus-cure-backend.vercel.app

# ---------------------------------------------------------------------------
# CC-60: face login
#
# Face is the SECOND factor, never the first. The descriptor is computed in the
# browser, so anyone can POST 128 floats without a camera - which makes
# face-as-a-first-factor a bearer secret derived from a photograph. The
# password is what guards the account; this raises the cost on top of it.
#
# WITHOUT A KEY, FACE LOGIN IS OFF: enrolment refuses and the password step
# never asks for a face. Users simply log in with a password. That is a safe
# degradation, not a broken one.
# ---------------------------------------------------------------------------

# 32 bytes, base64:  openssl rand -base64 32
#
# Losing this means enrolled users must re-enrol - a 30-second action, so it is
# inconvenience rather than disaster. The SAME value must be set wherever the
# app runs, or templates encrypted elsewhere cannot be read.
FACE_ENCRYPTION_KEY=

# Max euclidean distance for a 1:1 match (default 0.5). Tighter than
# face-api.js's usual 0.6, which is tuned for 1:N identification where a miss
# is an inconvenience; this guards a session.
FACE_MATCH_THRESHOLD=0.5

# Minimum pairwise distance between submitted samples (default 0.02). A photo
# held to a camera gives near-identical descriptors frame after frame.
# NOT calibrated against real captures yet - see the spec's open questions.
FACE_LIVENESS_MIN_VARIANCE=0.02

# Challenge lifetime in seconds (default 120), verifies allowed per challenge
# (default 3), and samples the client must submit (default 3).
FACE_CHALLENGE_TTL_SECONDS=120
FACE_MAX_ATTEMPTS=3
FACE_REQUIRED_SAMPLES=3

# ---------------------------------------------------------------------------
# CC-31: SLA timers and automatic escalation
#
# Escalation already existed but was REACTIVE - it needed a student to reject a
# resolution. This adds the clock, so a complaint nobody assigns (and which
# therefore has no resolution to reject) escalates on its own.
# ---------------------------------------------------------------------------

# Off means no deadline is ever set and the nightly sweep no-ops.
SLA_ENABLED=true

# Scales every budget. Mostly for demos and tests: at 0.001 a critical
# complaint breaches in about fifteen seconds, so the escalation ladder can be
# shown working without waiting four hours. Also the lever for tuning the
# budgets - which are GUESSES, not measurements - without a deploy.
#
# Defaults, in hours (assign / resolve), by priority 1 Low .. 5 Critical:
#   5 Critical  4 / 24      4 High  8 / 48      3 Medium  24 / 96
#   2 Low      48 / 168     1 Lowest 72 / 240
SLA_MULTIPLIER=1

# Escalations before the super admin takes ownership. NOTE this counts student
# rejections too - the counter is shared deliberately, see the spec.
SLA_MAX_ESCALATIONS=2

# Minimum gap between two escalations of one complaint. Without it, anything
# that stays overdue escalates on every sweep and the admin queue becomes a
# stream of the same three complaints.
SLA_ESCALATION_COOLDOWN_HOURS=24

# Silence before a student is nudged to confirm a resolution. Reminder only -
# a complaint waiting on the student NEVER counts as a staff SLA breach, and is
# never auto-resolved on their behalf.
SLA_CONFIRMATION_REMINDER_HOURS=72

# Complaints handled per sweep. Bounds the blast radius of one bad run.
SLA_SWEEP_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# CC-64: DPDP - consent, export, erasure, retention
# ---------------------------------------------------------------------------

# Bumping this invalidates every prior consent and re-prompts everyone. A date
# rather than a number, so "which policy did they agree to" needs no lookup.
DPDP_POLICY_VERSION=2026-09-21

# Off means the retention sweep returns zeroes without querying.
RETENTION_ENABLED=true

# Per-table limits in days.
#
# COMPLAINTS, DOUBTS, ANSWERS AND AUDIT ROWS ARE DELIBERATELY ABSENT and are on
# no clock at all. Complaints are the record of the institution's own conduct,
# and a complaints system that quietly deletes complaints after a year has the
# one failure mode it cannot have. The audit log is what CC-61 exists to keep.
RETENTION_NOTIFICATION_DAYS=180
RETENTION_DOUBT_VIEW_DAYS=90

# Sent mail is delivery evidence and its body holds personal data; failures are
# kept longer because diagnosing "why did nothing arrive" needs the history.
RETENTION_EMAIL_SENT_DAYS=90
RETENTION_EMAIL_FAILED_DAYS=365

# ---------------------------------------------------------------------------
# CC-25: reputation
# ---------------------------------------------------------------------------
REPUTATION_ENABLED=true

# Points one user may EARN per day. Caps earning, not voting: a capped upvote
# still registers and still counts on the answer, it just stops paying.
# Dropping the vote instead would leave the voter thinking their click did
# nothing.
#
# This is the weakest of the three anti-gaming controls and the only one that
# is a judgement - the other two (self-awards score zero, one award per actor
# per source) are enforced by code and by a unique index.
REPUTATION_DAILY_CAP=50

# ---------------------------------------------------------------------------
# CC-42: Telegram notifications
#
# The second provider over CC-03's outbox. Free, instant, and gated on nothing
# - no domain, no DNS, no business verification - which is why it exists while
# Resend is still sandboxed.
#
# Absent token => the channel is off: linking refuses, the webhook 404s, and
# nothing is ever queued on it.
#
# Setup:
#   1. Message @BotFather on Telegram, /newbot, copy the token.
#   2. Pick any long random string for TELEGRAM_WEBHOOK_SECRET.
#   3. Register the webhook:
#      curl -F "url=https://<your-api>/api/telegram/webhook" \
#           -F "secret_token=<TELEGRAM_WEBHOOK_SECRET>" \
#           https://api.telegram.org/bot<TOKEN>/setWebhook
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Returned by Telegram in X-Telegram-Bot-Api-Secret-Token. The webhook URL is
# PUBLIC - without this an attacker who guesses it can forge a "/start <code>"
# from any chat id and link their own Telegram to somebody else's account.
TELEGRAM_WEBHOOK_SECRET=

# Linking code lifetime.
TELEGRAM_LINK_TTL_MINUTES=15
