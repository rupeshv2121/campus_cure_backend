# CampusCure backend configuration.
# Copy to .env and fill in. NEVER commit .env or put real values in this file.

# --- Required. The server refuses to start without these (src/config/env.ts) ---

# Supabase Postgres connection string (pooled).
DATABASE_URL=

# CC-01b: access token lifetime. Accepts "15m", "2h" or a plain number of
# seconds. Short by design — an access token cannot be revoked, so its blast
# radius is bounded only by how long it lives. The refresh token behind it
# carries the session and IS revocable.
# Raise this without a deploy if 15 minutes proves too aggressive.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing this invalidates every issued token and logs all users out.
JWT_SECRET=

# --- Optional ---

# Extra origin allowed by CORS, e.g. http://localhost:5173
# localhost:5173/5174 and the deployed frontend are always allowed.
FRONTEND_URL=

# "production" enables production behaviour. Defaults to "development".
NODE_ENV=

# --- AI / embeddings (CC-10). All optional: the app runs fully without them. ---

# HuggingFace token. MUST have the global "Make calls to Inference Providers"
# permission — a plain Read token returns 403. Get one at:
#   https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Canonical embedding model. Changing it invalidates every stored vector and
# requires a full backfill — vectors from different models are not comparable.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Measured ~7ms/item at 50, vs ~572ms for a single item. Batch generously.
EMBEDDING_BATCH_SIZE=50

# Master switch. Defaults on when HF_API_TOKEN is set; "false" always wins.
AI_ENABLED=true

# Shared secret for /api/internal/* (the embedding drain). Machine-to-machine
# only. Generate: openssl rand -base64 32
INTERNAL_API_SECRET=

# Set this in Vercel to let Cron call the drain (sent as Authorization: Bearer).
CRON_SECRET=

# CC-13 duplicate complaint detection. Cosine-similarity floor for calling two
# complaints duplicates. Calibrated on 16 labelled pairs: lowest true duplicate
# 0.538, highest distinct pair 0.499. Narrow margin - re-run
#   npx tsx src/scripts/calibrateDuplicateThreshold.ts
# before changing it.
DUPLICATE_SIMILARITY_THRESHOLD=0.52

# --- Generation providers (CC-12, CC-15). Optional; features degrade without them. ---

# Groq. Model IDs discovered live 2026-09-20 from /openai/v1/models - the
# catalogue had changed completely from what documentation suggested, so list it
# rather than trusting any written-down id:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#
# NOTE: gpt-oss is a REASONING model. It emits reasoning tokens before content,
# so a small max_tokens returns content:"" with finish_reason:"stop" - no error,
# just silence. Budget generously and treat empty content as a failure.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mistral, used as the generation fallback and for vision (CC-50).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=mistral-medium-latest

# CC-12: hours a doubt must go unanswered before an AI draft is generated.
# Humans get first refusal - without this the AI would always answer first and
# undercut the student community CC-25 exists to build.
DRAFT_DELAY_HOURS=24

# CC-12: minimum cosine similarity for a past answer to be usable as grounding
# for an AI draft. Search can rank loosely related results and let the reader
# judge; grounding cannot — irrelevant grounding produces a draft that says
# "the reference material does not cover this", wasting the reviewer's time.
GROUNDING_SIMILARITY_THRESHOLD=0.45

# CC-04: set to a THROWAWAY database to enable Tier 2 integration tests.
# Leave unset for normal runs. The suite aborts if this is unset while
# DATABASE_URL points at Supabase, so a misconfigured run cannot touch
# production.
TEST_DATABASE_URL=
