generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  name               String
  email              String          @unique
  password           String
  userID             String          @unique @map("username")
  university         String          @default("UNSPECIFIED")
  isActive           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  id                 String          @id @default(uuid())
  role               Role
  approvalStatus     ApprovalStatus
  /// CC-60. DEPRECATED and cleared by encryptFaceDescriptors.ts. Kept only so
  /// the one-time migration script has something to read. Never written again.
  faceDescriptor     Float[]         @default([])
  /// CC-60. AES-256-GCM, "iv:tag:ciphertext" in base64. Biometric template
  /// data is regulated under the DPDP Act and, unlike a password, cannot be
  /// changed by its subject once leaked. GCM rather than CBC because it
  /// authenticates: a tampered template fails to decrypt instead of silently
  /// comparing against modified data.
  faceDescriptorEnc  String?
  adminProfile       AdminProfile?
  answers            Answer[]
  moderatedAnswers   Answer[]        @relation("ModeratedAnswers")
  answerUpvotes      AnswerUpvote[]
  assignedComplaints Complaint[]     @relation("AssignedComplaints")
  raisedComplaints   Complaint[]     @relation("RaisedComplaints")
  doubts             Doubt[]
  doubtViews         DoubtView[]
  doubtUpvotes       DoubtUpvote[]
  facultyProfile     FacultyProfile?
  studentProfile     StudentProfile?
  notifications      Notification[]
  /// CC-40. One switch for all notification email. Transactional only - about
  /// the user's own complaint or their own doubt - so it defaults to on.
  emailNotifications Boolean         @default(true)
  /// CC-40. Random per user and deliberately NOT derived from the id: an
  /// unsubscribe link travels in clear text through mail servers, logs and
  /// forwarded messages, so it must not expose or be forgeable from anything
  /// else. Minted lazily on the first email.
  unsubscribeToken   String?         @unique
  refreshTokens      RefreshToken[]
  attachments        Attachment[]
  doubtBookmarks     DoubtBookmark[]
  faceChallenges     FaceChallenge[]
  consentRecords     ConsentRecord[]
  /// CC-64. Set when the data principal exercised their right to erasure.
  /// The row survives as a tombstone because deleting it is impossible
  /// (foreign keys) and undesirable (a doubt with twelve answers is not only
  /// its author's data).
  erasedAt           DateTime?
}

model StudentProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  enrollmentNumber      String   @unique
  department            String
  branch                String
  semester              Int
  phoneNumber           String
  address               String
  isStudying            Boolean  @default(true)
  guardianName          String
  guardianPhone         String
  doubtsAsked           Int      @default(0)
  doubtsSolved          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  totalActiveComplaints Int      @default(0)
  totalComplaints       Int      @default(0)
  user                  User     @relation(fields: [userId], references: [id])
}

model FacultyProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  department   String
  branch       String
  phoneNumber  String
  address      String
  isTeaching   Boolean  @default(true)
  subjects     String[]
  doubtsSolved Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model AdminProfile {
  id                  String     @id @default(uuid())
  userId              String     @unique
  adminLevel          AdminLevel
  manageUsers         Boolean    @default(false)
  manageComplaints    Boolean    @default(false)
  manageDoubts        Boolean    @default(false)
  viewAnalytics       Boolean    @default(false)
  assignedDepartments String[]
  allowedCategories   String[]
  doubtSubjects       String[]   @default([])
  complaintsAssigned  Int        @default(0)
  complaintsClosed    Int        @default(0)
  usersManaged        Int        @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id])
}

model Doubt {
  id               String                      @id @default(uuid())
  title            String
  description      String
  semester         Int
  subject          String
  /// As the author typed it. Never overwritten and never rendered directly:
  /// display goes through the vocabulary's canonical casing (CC-20).
  labels           String[]
  /// CC-20. Derived from `labels` on every write. Never user-supplied, never
  /// rendered: it is the lookup key that filtering, aggregation and canonical
  /// display all match on. `labels` remains the source of truth - if the two
  /// ever disagree, `labels` is right and this is stale.
  labelsNormalized String[]                    @default([])
  postedById       String
  status           DoubtStatus                 @default(OPEN)
  views            Int                         @default(0)
  upVoteCount      Int                         @default(0)
  answerCount      Int                         @default(0)
  acceptedAnswerId String?
  edited           Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  editHistory      Json                        @default("[]")
  /// CC-10. Prisma has no native vector type, so this is invisible to the typed
  /// client: all reads and writes go through src/repositories/embeddingRepository.ts.
  /// NEVER select this implicitly - it is ~1.5KB per row.
  embedding        Unsupported("vector(384)")?
  /// The model that produced `embedding`. Vectors from different models are not
  /// comparable, so a model change is a detectable backfill, not silent corruption.
  embeddingModel   String?
  embeddingVersion Int                         @default(1)
  embeddedAt       DateTime?
  answers          Answer[]
  postedBy         User                        @relation(fields: [postedById], references: [id])
  doubtViews       DoubtView[]
  doubtUpvotes     DoubtUpvote[]
  doubtBookmarks   DoubtBookmark[]

  @@index([labelsNormalized], type: Gin)
}

model Answer {
  id             String         @id @default(uuid())
  doubtId        String
  content        String
  answeredById   String
  approvalStatus ApprovalStatus @default(APPROVED)
  upvotes        Int            @default(0)
  isVerified     Boolean        @default(false)
  isAccepted     Boolean        @default(false)
  edited         Boolean        @default(false)
  moderatedById  String?
  moderatedAt    DateTime?
  moderationNote String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  editHistory    Json           @default("[]")
  /// CC-12. Permanent: a reader can always tell an answer began as an AI draft,
  /// even after a faculty member edited and approved it.
  aiAssisted     Boolean        @default(false)
  answeredBy     User           @relation(fields: [answeredById], references: [id])
  doubt          Doubt          @relation(fields: [doubtId], references: [id])
  moderatedBy    User?          @relation("ModeratedAnswers", fields: [moderatedById], references: [id])
  answerUpvotes  AnswerUpvote[]
}

model DoubtView {
  id       String   @id @default(uuid())
  doubtId  String
  userId   String
  viewedAt DateTime @default(now())
  doubt    Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doubtId, userId])
  @@index([userId])
  @@index([doubtId])
}

model AnswerUpvote {
  id        String   @id @default(uuid())
  answerId  String
  userId    String
  upvotedAt DateTime @default(now())
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@index([userId])
  @@index([answerId])
}

model DoubtUpvote {
  id        String   @id @default(uuid())
  doubtId   String
  userId    String
  upvotedAt DateTime @default(now())
  doubt     Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doubtId, userId])
  @@index([userId])
  @@index([doubtId])
}

model Complaint {
  id                      String                      @id @default(uuid())
  title                   String
  description             String
  category                String
  classroomNumber         String
  block                   String
  status                  ComplaintStatus             @default(RAISED)
  priority                Int
  raisedById              String
  assignedToId            String?
  resolutionNote          String?
  resolutionDate          DateTime?
  studentConfirmed        Boolean                     @default(false)
  studentConfirmationDate DateTime?
  feedbackRating          Int?
  feedbackComment         String?
  studentRejectionMessage String?
  escalationCount         Int                         @default(0)
  handledBySuperAdmin     Boolean                     @default(false)
  superAdminId            String?
  rejectionHistory        Json                        @default("[]")
  assignmentHistory       Json                        @default("[]")
  assignedAt              DateTime?
  pendingConfirmationAt   DateTime?
  /// CC-31. When staff are next due to have acted. Written when the clock
  /// starts - on create, and again on assignment - rather than derived on
  /// every sweep, so the sweep is one indexed query and an admin can be shown
  /// "due in 3 hours" without the frontend reimplementing the policy.
  ///
  /// NULL means no staff clock is running: resolved, escalated to the top, or
  /// waiting on the student.
  slaDueAt                DateTime?
  /// CC-31. Cooldown anchor, so a breached complaint escalates once per
  /// cooldown rather than once per sweep.
  lastEscalationAt        DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  /// CC-13. Same contract as Doubt.embedding: invisible to the typed client,
  /// written only through embeddingRepository, never selected implicitly.
  embedding               Unsupported("vector(384)")?
  embeddingModel          String?
  embeddingVersion        Int                         @default(1)
  embeddedAt              DateTime?
  assignedTo              User?                       @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  raisedBy                User                        @relation("RaisedComplaints", fields: [raisedById], references: [id])

  /// CC-31: drives the nightly overdue sweep.
  @@index([status, slaDueAt])
}

/// CC-01b: a revocable session behind a short-lived access token.
///
/// Deliberately NOT a JWT: it carries no claims, so it cannot be inspected or
/// trusted on its own. Its only meaning is "this row exists and is not
/// revoked". Only the SHA-256 hash is stored, so a database leak does not hand
/// over working sessions.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// CC-12: an AI-written answer awaiting faculty review.
///
/// Drafts live here rather than in Answer so they are structurally incapable of
/// reaching a student: no student query touches this table. Approval creates a
/// real Answer authored by the reviewing faculty member.
model AnswerDraft {
  id               String    @id @default(uuid())
  /// One outstanding draft per doubt, which makes generation idempotent.
  doubtId          String    @unique
  content          String
  model            String
  /// Answer ids used as grounding, so a reviewer can audit the draft.
  sourceIds        String[]  @default([])
  status           String    @default("PENDING")
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  /// False here means the reviewer approved the text verbatim. Recorded so
  /// rubber-stamping is measurable rather than merely discouraged.
  editedOnApproval Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

/// CC-10: work queue for asynchronous embedding.
///
/// Embedding never happens inline: HuggingFace cold starts take 20+ seconds and
/// an AI outage must never stop a student posting a doubt.
model EmbeddingJob {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([status, createdAt])
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DoubtStatus {
  OPEN
  ANSWERED
  RESOLVED
}

enum ComplaintStatus {
  RAISED
  ASSIGNED
  IN_PROGRESS
  PENDING_CONFIRMATION
  ESCALATED_TO_SUPERADMIN
  RESOLVED
}

enum AdminLevel {
  SUPER
  NORMAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json? // Store additional data like complaintId, doubtId, etc.
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  COMPLAINT_STATUS_UPDATE
  COMPLAINT_ASSIGNED
  DOUBT_ANSWER
  DOUBT_ACCEPTED
  ANSWER_UPVOTED
  GENERAL
}

/// CC-02. A file in Supabase Storage, and the record of what it belongs to.
///
/// Rows are created in PENDING when an upload is signed and only become
/// ATTACHED once the bytes are confirmed to exist, inside the same transaction
/// that creates the parent entity. A PENDING row is a reservation, not a file:
/// no read path may return one, and the daily sweep removes stale ones.
model Attachment {
  id           String            @id @default(uuid())
  /// Object key inside the bucket. Server-generated, never client-supplied:
  /// a client-chosen path is a path-traversal and overwrite primitive.
  storagePath  String            @unique
  bucket       String
  mimeType     String
  sizeBytes    Int
  originalName String
  status       AttachmentStatus  @default(PENDING)
  /// Null until confirmed.
  ///
  /// `entityId` is deliberately NOT a foreign key: four possible parents cannot
  /// be one Prisma relation, and four nullable FK columns would make every read
  /// path branch on which one is set. EmbeddingJob makes the same trade-off.
  /// The cost is no cascade from the parent — the daily sweep covers it.
  entityType   AttachmentEntity?
  entityId     String?
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  confirmedAt  DateTime?

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([status, createdAt])
}

enum AttachmentStatus {
  PENDING
  ATTACHED
}

enum AttachmentEntity {
  DOUBT
  ANSWER
  COMPLAINT
  COMPLAINT_RESOLUTION
}

/// CC-21. A private "save for later" on a doubt.
///
/// Mirrors DoubtUpvote exactly - same composite unique, same cascades, same
/// index pair - because it is the same shape of relationship and inventing a
/// second convention for it would be gratuitous.
///
/// There is deliberately NO denormalised count on Doubt, unlike upVoteCount.
/// A counter exists to be displayed, and displaying this one would turn a
/// private action public and change behaviour.
model DoubtBookmark {
  id      String   @id @default(uuid())
  doubtId String
  userId  String
  savedAt DateTime @default(now())
  doubt   Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doubtId, userId])
  @@index([userId])
  @@index([doubtId])
}

/// CC-03. An email waiting to be sent, or the record of one that was.
///
/// Rows are written inside the transaction that caused them and sent by a
/// separate drain. A Vercel lambda freezes once the response is sent, so
/// "fire and forget after res.json()" is not a thing that reliably runs -
/// durable beats asynchronous here.
///
/// Mirrors EmbeddingJob on purpose. A second queue with different retry
/// semantics is one more thing to reason about when something breaks.
model EmailOutbox {
  id          String      @id @default(uuid())
  /// The real recipient, always - even when EMAIL_REDIRECT_TO diverts the
  /// actual send elsewhere. Turning the redirect off must not need a re-send.
  to          String
  subject     String
  bodyText    String
  bodyHtml    String?
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  /// Makes enqueueing idempotent. A retried handler that reuses the key
  /// writes nothing and sends nothing twice.
  dedupeKey   String?     @unique
  /// Earliest the drain may claim this. Backoff pushes it forward.
  scheduledAt DateTime    @default(now())
  sentAt      DateTime?
  /// Resend's id, so a delivery question can be traced at the provider.
  providerId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, scheduledAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// CC-60. A pending face verification, created by the password step.
///
/// Face is the SECOND factor: this row only exists once a password has already
/// been verified, and it is the only way to reach the face endpoint. Short
/// lived, single use and attempt capped, which is what stops a captured
/// request being replayed and a known account being brute forced in
/// descriptor space.
model FaceChallenge {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 of the nonce, never the nonce itself. Possession of this table
  /// must not be possession of a credential - same reasoning as RefreshToken.
  nonceHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// CC-61. An immutable record of a privileged action.
///
/// Append-only: nothing in the application updates or deletes a row, and a
/// database trigger raises on UPDATE and DELETE so that convention is backed
/// by a control. A superuser can still drop the trigger - this is
/// tamper-RESISTANT, not tamper-proof. See the spec.
model AuditLog {
  id         String     @id @default(uuid())
  actorType  AuditActor @default(USER)
  /// Deliberately NOT a relation. A cascade would let anyone erase their own
  /// history by deleting their account, which is the exact thing this table
  /// exists to prevent.
  actorId    String?
  /// Snapshot of who they were AT THE TIME. An entry must stay meaningful
  /// after the account is gone or its role has changed - looking it up later
  /// would answer today's question about a past event.
  actorRole  String?
  actorLabel String?
  /// Dotted string, e.g. "complaint.assign". Not an enum: an enum means a
  /// migration every time a new action is audited, and that tax gets paid by
  /// not auditing the new thing.
  action     String
  targetType String
  targetId   String?
  summary    String
  /// Scrubbed before writing - see redact() in services/audit/auditLog.ts.
  /// Audit metadata is attacker-interesting by construction.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

enum AuditActor {
  USER
  SYSTEM
}

/// CC-64. One row per consent grant or withdrawal.
///
/// Append-only by convention: nothing updates a row, so "what did I agree to,
/// and when did I change my mind" is answerable from the history rather than
/// from whatever the current policy says.
model ConsentRecord {
  id            String   @id @default(uuid())
  userId        String
  /// Bumping this in code invalidates prior consent and re-prompts.
  policyVersion String
  granted       Boolean
  /// What the user was actually shown at the time, not what the site says now.
  purposes      String[]
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
